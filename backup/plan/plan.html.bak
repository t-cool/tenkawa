                            if (key === 't4_2' && (text.includes('要点を分かりやすく整理して工夫して表現している') || text.includes('分かりやすく表現している') || text.length < 45)) {
                                text = '伝えたい相手を明確に意識し、調べた事実や自分の考えを言葉や図表に整理して、工夫して発表・表現している。';
                            }
                            if (key === 't4_3' && (text.includes('根拠を示しながら効果的に伝えている') || text.includes('相手意識や目的意識を持って表現方法を選択し') || text.length < 48)) {
                                text = '相手や目的に応じた適切な表現手段を選び、根拠や理由を明確に示しながら、説得力をもって効果的に伝えている。';
                            }
                            if (key === 't4_4' && (text.includes('目的や相手の立場に応じ、調べ考えたことを論理的な構成で説得力を持って発信・提案している') || text.includes('相手や目的、意図に応じて論理的に表現している') || text.includes('調べたり考えたりしたことをまとめ') || text.length < 50)) {
                                text = '相手の立場や社会的文脈を踏まえ、探究の成果を論理的な構成でまとめ、地域や社会に向け説得力をもって提言している。';
                            }
                            if (key === 'a1_1' && (text.includes('身近な人や自然に関心を持ち、進んで関わり活動を楽しもうとしている') || text.includes('地域の人と楽しく関わり'))) {
                                text = '身近な人々、社会及び自然に自ら働きかけ、意欲や自信をもって活動を楽しみ、生活を豊かにしようとしている。';
                            }
                            if (key === 'a1_2' && (text.includes('自らの課題意識を持ち、意欲を持って探究活動に進んで取り組もうとしている') || text.includes('探究活動に向け進んで取り組もう') || text.length < 45)) {
                                text = '身近な地域の事象に興味・関心をもち、自らの課題に向かって見通しをもち、進んで粘り強く探究に取り組もうとしている。';
                            }
                            if (key === 'a1_3' && (text.includes('明確な目標を持ち、試行錯誤しながら粘り強く課題解決に取り組もうとしている') || text.includes('目標をもちながら、課題解決に向けた探究活動に進んで取り組もうとしている') || text.length < 48)) {
                                text = '探究の意義を自覚し、明確な目標を掲げて試行錯誤を恐れず、主体的に粘り強く課題の解決に取り組もうとしている。';
                            }
                            if (key === 'a1_4' && (text.includes('自らの意思と責任を持って探究を推進し、見通しを持って主体的に行動しようとしている') || text.includes('自他のよさを生かしながら協働して') || text.length < 48)) {
                                text = '自らの進路や生き方を見据え、探究の意義と責任を自覚しながら、見通しをもって主体的に行動しようとしている。';
                            }
                            if (key === 'a2_1' && (text.includes('友達と一緒に活動し、互いの思いを伝え合い良さに気付こうとしている') || text.includes('他者の考えや意見を取り入れながら活動に取り組み'))) {
                                text = '友達や身近な人々と進んで関わり、互いの思いを伝え合ったり良さに気付いたりしながら、協力して活動を楽しもうとしている。';
                            }
                            if (key === 'a2_2' && (text.includes('互いの意見を聞き合い、役割を分担しながら協力して学び合おうとしている') || text.includes('他者の意見を比べたり取り入れたりしながら') || text.length < 45)) {
                                text = '友達と互いの考えを伝え合い、役割を分担して助け合いながら、他者と協同して問題の解決に取り組もうとしている。';
                            }
                            if (key === 'a2_3' && (text.includes('他者の立場を尊重し、意見を交流・調整しながら力を合わせて深め合おうとしている') || text.includes('他者と力を合わせて活動し、他者の立場を尊重しながら') || text.length < 48)) {
                                text = '互いのよさや多様な考えを認め合い、意見を調整・協同しながら、仲間と協同して学びを深め合おうとしている。';
                            }
                            if (key === 'a2_4' && (text.includes('多様な価値観や異なる意見を受け入れ、互いの強みを生かしてよりよい合意形成を図ろうとしている') || text.includes('探究的な学習を通して自分の特徴やよさを理解するとともに') || text.includes('異なる意見や他者の考えを受け入れ尊重しようとしている') || text.length < 50)) {
                                text = '多様な他者の価値観や立場を尊重し、対話を通じて互いの強みを生かし、協同してよりよい合意形成を図ろうとしている。';
                            }
                            if (key === 'a3_1' && (text.includes('地域のよさを感じ、身近な生活の中で自分にできることを考えようとしている') || text.includes('地域のよさを知り、自分たちにできることを考えようとしている'))) {
                                text = '地域の場所や人々、自然に親しみや愛着をもち、集団や社会の一員として安全で適切な行動をし、自分にできることを果たそうとしている。';
                            }
                            if (key === 'a3_2' && (text.includes('地域とのつながりを意識し、地域のよさを広めたり役に立とうとしたりしている') || text.includes('自分ができることを見付けようとしている') || text.length < 45)) {
                                text = '日常生活と地域社会とのつながりを意識し、天川村のよさや魅力を見付け、身近な人々に広め役立とうとしている。';
                            }
                            if (key === 'a3_3' && (text.includes('地域課題に当事者意識を持ち、地域の人々と協力して問題解決に取り組もうとしている') || text.includes('進んで地域の問題の解決に取り組もうとしている') || text.length < 48)) {
                                text = '地域社会の課題を自らの問題として捉え、地域の人々と協同しながら、ふるさとのよりよい発展に参画しようとしている。';
                            }
                            if (key === 'a3_4' && (text.includes('地域課題の解決や地域活動に主体的な担い手として積極的に参画・行動しようとしている') || text.includes('進んで実社会・実生活の問題の解決に取り組むとともに') || text.includes('実社会') || text.length < 50)) {
                                text = '天川村の持続可能な未来を見据え、社会の担い手としての自覚をもち、課題解決に向け積極的に参画・行動しようとしている。';
                            }
                            if (key === 'plan_school_goal' && text.includes('社会を切り拓く力を育む')) {
                                text = 'ふるさとを愛し、自らの未来を主体的に切り拓く児童生徒の育成';
                            }
                            if (key === 'box2_content' && (text.includes('メディアセンター') || !text.includes('帯活動') || !text.includes('ふるさと人材バンク'))) {
                                text = '・帯活動を通して、全校指導体制を組織する。\n・地域の教育資源をデータ化するとともに、日常的な関わりを行う。\n・ふるさと人材バンクを活用する。';
                            }
                            if (key === 'box6_content' && (text.includes('天川幼稚園') || text.includes('学校サポーター') || text.includes('こども園') || text.includes('にぎわい創出協議会'))) {
                                text = '・社会福祉協議会\n・地域の行事\n・村役場\n・村の交流施設 など';
                            }
                            if (key === 'box4_content' && (text.includes('キャリアパスポート') || text.includes('個人内評価') || text.includes('授業分析') || !text.includes('ポートフォリオを活用した評価の充実を図る'))) {
                                text = '・指導と評価の一体化を充実する。\n・観点別学習状況を把握するための評価規準を設定する。\n・ポートフォリオを活用した評価の充実を図る。';
                            }
                            if (key === 'plan_student_status' && (text.includes('自己の強みを自覚しにくい') || text.includes('論理的に考えを伝える意識') || text.includes('主体的に判断・行動する。') || text.includes('明るく元気、素直') || text.includes('自信を持つことが苦手'))) {
                                text = `(実態)\n・素直で郷土愛にあふれ、温和で明るい。\n・固定的な人間関係や比較対象の少なさから、自己の強みや弱みを自覚しにくい。\n・互いに阿吽の呼吸で通じるため、筋道を立てて考えを伝える意識が希薄である。\n\n(課題)\n・自ら状況を捉え、主体的に判断・行動すること。\n・固定化した関係にとどまらず、多様な他者の視点を認めて広げる。`;
                            }
                            if (key === 'plan_student_vision' && (text.includes('自分で考え、正しい判断ができる子') || text.includes('夢と希望をもち続ける子') || text.includes('知・主体性') || !text.includes('（知）'))) {
                                text = '・自ら学び、考え、行動する子（知）\n・自分と人を思いやり、ふるさと天川を愛する子（徳）\n・心身ともにたくましく、夢に向かって生きぬく子（体）';
                            }
                            el.innerText = text.trim();
                        }
                    });
                }
            } catch (e) {
                console.error("Section 2 load error", e);
            }
        }

        // テキストエリア自動リサイズ
        function autoResizeTextarea(textarea) {
            if (!textarea) return;
            textarea.style.height = 'auto';
            textarea.style.height = (textarea.scrollHeight) + 'px';
        }

        // 初期化リスナー
        window.addEventListener('DOMContentLoaded', () => {
            loadSection1Data();
            loadSection2Data();

            // テキストエリアの入力時リスナー
            document.querySelectorAll('textarea').forEach(textarea => {
                textarea.addEventListener('input', () => {
                    autoResizeTextarea(textarea);
                    saveSection1Data();
                });
                autoResizeTextarea(textarea);
            });

            // セクション1 タイトルの入力時リスナー
            const docTitle = document.getElementById('doc_title');
            if (docTitle) {
                docTitle.addEventListener('input', () => {
                    saveSection1Data();
                });
            }

            // セクション2 [data-key] の入力時リスナー
            document.querySelectorAll('[data-key]').forEach(element => {
                element.addEventListener('input', () => {
                    saveSection2Data();
                });
            });

            // 定期自動保存 (30秒ごと)
            setInterval(() => {
                saveSection1Data();
                saveSection2Data();
            }, 30000);
        });

        // A3用紙（縦）PDFダウンロード関数
        async function downloadA3PDF() {
            if (document.activeElement) {
                document.activeElement.blur();
            }

            showToast("A3 PDFを作成中... 少々お待ちください", false);

            const card = document.querySelector('.print-card');
            if (!card) return;

            if (typeof html2canvas === 'undefined' || !window.jspdf) {
                showToast("PDF生成ライブラリを読込中のため、印刷画面を開きます", false);
                window.print();
                return;
            }

            // PDF生成用に一時的に余白・影・枠線を調整
            card.classList.add('pdf-exporting');

            try {
                // 解像度scale: 2で高品質レンダリング
                const canvas = await html2canvas(card, {
                    scale: 2,
                    useCORS: true,
                    logging: false,
                    backgroundColor: '#ffffff',
                    ignoreElements: (el) => el.classList.contains('no-print'),
                    onclone: (clonedDoc) => {
                        const style = clonedDoc.createElement('style');
                        style.textContent = 'img { display: inline-block !important; }';
                        clonedDoc.head.appendChild(style);
                    }
                });

                const imgData = canvas.toDataURL('image/jpeg', 0.98);

                // A3 縦仕様 (幅297mm × 高さ420mm)
                const pdfWidth = 297;
                const pdfHeight = 420;
                const margin = 10; // 余白 10mm
                const usableWidth = pdfWidth - margin * 2;
                const usableHeight = pdfHeight - margin * 2;

                const canvasWidth = canvas.width;
                const canvasHeight = canvas.height;
                const canvasRatio = canvasWidth / canvasHeight;

                // 横幅と高さをA3縦枠内に最適化
                let imgWidth = usableWidth;
                let imgHeight = usableWidth / canvasRatio;

                if (imgHeight > usableHeight) {
                    imgHeight = usableHeight;
                    imgWidth = usableHeight * canvasRatio;
                }

                // ページ中央配置
                const x = margin + (usableWidth - imgWidth) / 2;
                const y = margin + (usableHeight - imgHeight) / 2;

                const { jsPDF } = window.jspdf;
                const pdf = new jsPDF({
                    orientation: 'portrait',
                    unit: 'mm',
                    format: 'a3'
                });

                pdf.addImage(imgData, 'JPEG', x, y, imgWidth, imgHeight);

                const now = new Date();
                const dateStr = now.toISOString().slice(0, 10);
                const titleText = (document.getElementById('doc_title')?.innerText || 'R９年度_ふるさと学習（総合的な学習の時間）_全体計画').trim().replace(/[\s\t\n]+/g, '_');
                pdf.save(`${titleText}_A3_${dateStr}.pdf`);

                showToast("A3 PDFをダウンロードしました", false);
            } catch (err) {
                console.error("PDF generation failed", err);
                showToast("PDF生成エラーが発生したため、印刷画面を開きます", true);
                window.print();
            } finally {
                card.classList.remove('pdf-exporting');
            }
        }
    </script>
</body>
</html>
